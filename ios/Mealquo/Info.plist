  <key>WKAppBoundDomains</key><array><string>mealquo.mealquo.workers.dev</string></array>
  <key>NSCameraUsageDescription</key><string>Mealquo robi zdjęcie talerza, żeby policzyć kalorie.</string>
  <key>NSMicrophoneUsageDescription</key><string>Mealquo słucha, gdy mówisz, co zjadłeś.</string>
  <key>NSLocationWhenInUseUsageDescription</key><string>Mealquo szuka restauracji obok, gdy wybierzesz „Jestem w restauracji”.</string>
  <key>NSPhotoLibraryUsageDescription</key><string>Mealquo bierze zdjęcie posiłku z galerii, gdy je wybierzesz.</string>
  <key>NSHealthShareUsageDescription</key><string>Mealquo pobiera treningi i spalone kalorie z Apple Health, gdy wybierzesz „Pobierz z zegarka”.</string>
</dict>
</plist>
